+package com.byd.clusternav.launcher
+
+import android.graphics.Color
+import android.view.View
+import android.view.ViewTreeObserver
+import android.widget.ImageView
+import com.byd.clusternav.R
+
+/**
+ * ═══ FIX286 · ES2 — tô nút ⇄ của Ô TRỐNG theo độ chói ĐO dưới nút (phương án A: không nền) ═══════════════════
+ *
+ * Spec `docs/specs/kachi-286-field-fixes.html` §3.4 ES2 + §4.4. Khung ô trống nay trong suốt (owner 03/10) ⇒ icon ⇄
+ * nằm thẳng lên ảnh nền người dùng chọn; màu do [SwapTint.choose] (thuần, `:core`) chọn giữa hai mực chính của hai
+ * bảng màu, theo khoảng độ chói đo được ở **khung chạm** của nút.
+ *
+ * ## Đo ở đâu
+ *  • **Có ảnh nền** ([WallArtStore.current]): [WallArt.luminanceRange] — khoảng độ chói các ô lưới 16×9 dưới khung
+ *    chạm, cùng hệ toạ độ trong cửa sổ mà thẻ kính dùng (`WallWindowDrawable.relocate`). Lưới đo ảnh ĐÃ làm tối nhưng
+ *    TRƯỚC hai dải che đỉnh/đáy màn của [WallView] ⇒ phần nút trong dải tính thêm qua [SwapTint.underBand].
+ *    [ĐO máy ảo 03/10] đã thử đọc ảnh mờ ¼ độ phân giải thay lưới: KHÔNG hơn (ảnh sọc tổng hợp, làm tối 0 %: một ô tốt
+ *    lên, một ô tệ đi; mọi ca khác y hệt) ⇒ giữ lưới. [SUY] ảnh ¼ dựng bằng `drawBitmap` lọc song tuyến, thu 4× chỉ lấy
+ *    mẫu vài điểm ⇒ chi tiết nhỏ hơn ~4 px răng cưa ở cả hai nguồn.
+ *  • **Không ảnh**: [WallView] vẽ nền chủ đề + hai vầng sáng ⇒ khoảng = độ chói của `BG`, `GLOW1`, `GLOW2`.
+ *
+ * ## Làm mới — KHÔNG mở đường mới
+ *  • Đổi ảnh / trình chiếu / bật–tắt hình nền ⇒ `KachiGlass.refresh(rootFrame)` (đã chạy ở đúng các lượt đó) dò
+ *    thêm tag [R.id.kachi_swap_tint] và gọi [retint]. Tag RIÊNG, không mượn tag kính: tag kính trên khung ô trống
+ *    chính là bẫy P1b (lượt refresh đắp kính lên ô trống — xem `WorkspaceView.makeSlot`).
+ *  • Đổi chủ đề ⇒ `WorkspaceView.restyle()` dựng lại ô trống ⇒ nút mới tự đo khi gắn vào cửa sổ.
+ *  • Ô đổi chỗ / đổi cỡ (bố cục tự vẽ đặt lại chỗ mà KHÔNG dựng lại ô) ⇒ `OnGlobalLayoutListener`: khung chạm không đổi
+ *    bound so với cha khi CẢ Ô di chuyển, nên `OnLayoutChangeListener` trên nút sẽ không bao giờ kích. Mỗi lượt chỉ là
+ *    một `getLocationInWindow` + so khoá; đo lại chỉ khi vị trí/cỡ/ảnh/chủ đề thật sự đổi.
+ */
+internal class SwapTintBinding private constructor(private val hit: View, private val icon: ImageView) :
+    View.OnAttachStateChangeListener, ViewTreeObserver.OnGlobalLayoutListener {
+
+    private val loc = IntArray(2)
+
+    /**
+     * Observer đã gắn listener — giữ để GỠ đúng cái đó. `view.viewTreeObserver` sau khi tháo khỏi cửa sổ có thể là
+     * một observer tạm khác hẳn ⇒ gỡ trên nó là không gỡ gì, listener rò theo cửa sổ.
+     */
+    private var vto: ViewTreeObserver? = null
+    private var lastKey: List<Any>? = null
+    private var lastLogged: String? = null
+
+    override fun onViewAttachedToWindow(v: View) {
+        vto?.takeIf { it.isAlive }?.removeOnGlobalLayoutListener(this)
+        vto = v.viewTreeObserver.also { it.addOnGlobalLayoutListener(this) }
+        retint(force = false)
+    }
+
+    override fun onViewDetachedFromWindow(v: View) {
+        vto?.takeIf { it.isAlive }?.removeOnGlobalLayoutListener(this)
+        vto = null
+    }
+
+    override fun onGlobalLayout() = retint(force = false)
+
+    /** Đo lại + tô. [force] = bỏ qua khoá (ảnh vừa đổi tại cùng đối tượng / lượt `KachiGlass.refresh`). */
+    fun retint(force: Boolean) {
+        if (!hit.isAttachedToWindow || hit.width <= 0 || hit.height <= 0) return
+        hit.getLocationInWindow(loc)
+        val art = WallArtStore.current
+        val key = listOf(loc[0], loc[1], hit.width, hit.height, System.identityHashCode(art), KachiTheme.night, KachiTheme.BG)
+        if (!force && key == lastKey) return
+        lastKey = key
+        val range = range(art, loc[0], loc[1], hit.width, hit.height, hit.rootView.height)
+        val next = SwapTint.choose(range[0], range[1], LIGHT_INK, DARK_INK)
+        icon.setColorFilter(next)
+        // ES6 — ghi khi màu ĐỔI hoặc ảnh bật/tắt (không mỗi ảnh trình chiếu): bản trên xe đo ra nền nào, chọn màu nào.
+        val sig = "$next|${art != null}"
+        if (sig != lastLogged) {
+            lastLogged = sig
+            android.util.Log.i(
+                "KachiWorkspace",
+                "[slot-empty] ⇄ @${loc[0]},${loc[1]} màu ${ColorMath.hex(next)} · nền L %.3f–%.3f · ảnh=%s"
+                    .format(java.util.Locale.ROOT, range[0], range[1], if (art != null) "on" else "off"),
+            )
+        }
+    }
+
+    private fun range(art: WallArt?, x: Int, y: Int, w: Int, h: Int, windowH: Int): DoubleArray {
+        if (art == null) {
+            return SwapTint.span(Color.parseColor(KachiTheme.BG), Color.parseColor(KachiTheme.GLOW1), Color.parseColor(KachiTheme.GLOW2))
+        }
+        val r = art.luminanceRange(x, y, x + w, y + h)
+        // Dải che đỉnh/đáy màn (chỉ vẽ khi có ảnh): hàng ô trên cùng có ⇄ nằm trong dải trên [ĐO máy ảo 02/10].
+        val bandH = (windowH * WallView.BAND_FRACTION).toDouble()
+        return SwapTint.underBand(r[0], r[1], Color.parseColor(KachiTheme.BAR_TOP), y, y + h, bandH, windowH)
+    }
+
+    companion object {
+        /** Mực sáng = mực chính bảng TỐI; mực tối = mực chính bảng SÁNG (spec ES2: *"hai màu chữ chính"*). */
+        private val LIGHT_INK = Color.parseColor(KachiPalette.DARK.ink)
+        private val DARK_INK = Color.parseColor(KachiPalette.LIGHT.ink)
+
+        /** Gắn tô-theo-nền cho nút ⇄ [icon] trong khung chạm [hit]. Gọi MỘT lần lúc dựng nút. */
+        fun bind(hit: View, icon: ImageView) {
+            val b = SwapTintBinding(hit, icon)
+            hit.setTag(R.id.kachi_swap_tint, b)
+            hit.addOnAttachStateChangeListener(b)
+            if (hit.isAttachedToWindow) b.onViewAttachedToWindow(hit)
+        }
+
+        /** Lượt `KachiGlass.refresh` (ảnh đổi): đo lại nút ⇄ trên [view] nếu có. */
+        fun refresh(view: View) {
+            (view.getTag(R.id.kachi_swap_tint) as? SwapTintBinding)?.retint(force = true)
+        }
+    }
+}
