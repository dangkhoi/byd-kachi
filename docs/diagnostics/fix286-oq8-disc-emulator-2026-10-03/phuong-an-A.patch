+package com.byd.clusternav.launcher
+
+/**
+ * ═══ FIX286 · ES2 — MÀU NÚT ⇄ CỦA Ô TRỐNG, CHỌN THEO ĐỘ CHÓI ĐO DƯỚI NÚT ═══════════════════════════════════════
+ *
+ * Spec `docs/specs/kachi-286-field-fixes.html` §3.4 ES2 + §4.4. Owner 03/10: khung trống (đã vẽ, chưa gán app) phải
+ * **trong suốt, thấy hình nền**, chỉ còn nút ⇄ để chọn app — phương án A: nút **không nền**.
+ *
+ * ## Vì sao phải chọn màu, không dùng `MUT` như ⇄ của các ô khác
+ * Ở ô có nội dung, ⇄ nằm trên một bề mặt mà bảng màu đã đo (kính/khay ô — `GlassVeil` giữ mực ≥ 4.5:1). Ô trống
+ * không còn bề mặt nào: icon nằm thẳng lên ảnh người dùng chọn, đã làm tối bằng `wallScrim #000000`. [SUY: tính WCAG
+ * ở phản biện 02/10] `MUT` sáng `#4c5869` chỉ 1.3–2.5:1 trên mọi ảnh đã làm tối, `MUT` tối `#9daabe` 1.4–2.2:1 khi
+ * ảnh sáng ⇒ ⇄ là dấu DUY NHẤT nói "chỗ này đặt được app" mà lại gần như vô hình. Không một màu cố định nào đạt
+ * 3:1 trên mọi ảnh; **hai** màu ở hai đầu độ chói thì luôn có một màu đạt (bài `SwapTintTest`).
+ *
+ * ## Vì sao đo một KHOẢNG độ chói, không một con số
+ * Lưới độ chói của ảnh là 16×9 ô (`WallArt`), ô lưới to hơn nút nhiều lần và nút có thể nằm vắt qua hai ô lưới. Chọn
+ * theo **trung bình** thì một nút nằm vắt qua mép trời sáng / mái nhà tối được tô theo một mức xám không có thật ở
+ * đâu cả. Chọn màu cho tương phản **tệ nhất** trên cả khoảng `[lo, hi]` thì đúng ở cả hai phía.
+ *
+ * ## Ngưỡng 3:1
+ * WCAG 2.x SC 1.4.11 (thành phần giao diện không phải chữ). Nút ⇄ là một icon, không phải chữ.
+ *
+ * Thuần số học, `Int` ARGB như [ColorMath]; không Android — `:app` chỉ đưa vào độ chói đo được và hai màu mực.
+ */
+object SwapTint {
+
+    /** Sàn WCAG 1.4.11 cho thành phần giao diện không phải chữ. */
+    const val MIN_CONTRAST = 3.0
+
+    /** Tỉ số tương phản giữa màu [ink] (đục) và một nền đồng nhất có độ chói WCAG [lum]. */
+    fun contrast(ink: Int, lum: Double): Double {
+        val a = ColorMath.luminance(ink)
+        val b = lum.coerceIn(0.0, 1.0)
+        return (maxOf(a, b) + 0.05) / (minOf(a, b) + 0.05)
+    }
+
+    /**
+     * Tương phản **tệ nhất** của [ink] trên mọi nền có độ chói trong `[lo, hi]`.
+     *
+     * Tỉ số chỉ giảm dần khi độ chói nền tiến về độ chói của mực ⇒ độ chói mực nằm TRONG khoảng thì có một điểm nền
+     * trùng màu mực (tỉ số 1); nằm ngoài thì điểm tệ nhất là đầu mút gần mực hơn — xét hai đầu mút là đủ.
+     */
+    fun worst(ink: Int, lo: Double, hi: Double): Double {
+        val a = minOf(lo, hi).coerceIn(0.0, 1.0)
+        val b = maxOf(lo, hi).coerceIn(0.0, 1.0)
+        val l = ColorMath.luminance(ink)
+        if (l in a..b) return 1.0
+        return minOf(contrast(ink, a), contrast(ink, b))
+    }
+
+    /**
+     * Chọn giữa mực [light] và mực [dark] màu có tương phản **tệ nhất** cao hơn trên khoảng độ chói `[lo, hi]` dưới
+     * nút. Hoà ⇒ [light] (ổn định: cùng đầu vào luôn ra cùng màu, không nhấp nháy giữa hai màu).
+     */
+    fun choose(lo: Double, hi: Double, light: Int, dark: Int): Int =
+        if (worst(dark, lo, hi) > worst(light, lo, hi)) dark else light
+
+    /** Nền đồng nhất — bất biến ES2 được phát biểu và kiểm trên dạng này. */
+    fun choose(lum: Double, light: Int, dark: Int): Int = choose(lum, lum, light, dark)
+
+    /**
+     * Độ chói của nền sau khi phủ thêm lớp [overlay] (có alpha) lên vùng có độ chói [lum] — để tính **dải che** đỉnh
+     * màn mà `WallView` vẽ đè lên ảnh (lưới độ chói của `WallArt` đo ảnh TRƯỚC dải che). Vùng ảnh mô hình bằng xám
+     * cùng độ chói, cùng lẽ [GlassVeil.alphaFor].
+     */
+    fun under(lum: Double, overlay: Int): Double =
+        if (ColorMath.alpha(overlay) == 0) lum.coerceIn(0.0, 1.0)
+        else ColorMath.luminance(ColorMath.over(overlay, ColorMath.grayOfLuminance(lum)))
+
+    /**
+     * Độ phủ (0..1) của hai dải che `WallView.drawBands` ở hàng điểm ảnh [y]: dải trên đục nhất ở `y = 0`, tan hết ở
+     * `y = bandH`; dải dưới ngược lại, từ `windowH − bandH` tới đáy. Ngoài hai dải ⇒ 0.
+     */
+    fun bandCover(y: Int, bandH: Double, windowH: Int): Double {
+        if (bandH <= 0.0) return 0.0
+        val top = 1.0 - y / bandH
+        val bottom = (y - (windowH - bandH)) / bandH
+        return maxOf(top, bottom).coerceIn(0.0, 1.0)
+    }
+
+    /**
+     * Khoảng độ chói `[lo, hi]` của ảnh dưới khung nút (đo từ lưới, TRƯỚC dải che) **sau** hai dải che màu [bar] (có
+     * alpha) — xem [bandCover]. Xét mép trên [top] và mép dưới [bottom] của khung rồi lấy khoảng BAO cả ảnh trần —
+     * bảo thủ, không giả định nút nằm ở đâu trong dải. Khung nằm ngoài cả hai dải ⇒ trả nguyên khoảng.
+     */
+    fun underBand(lo: Double, hi: Double, bar: Int, top: Int, bottom: Int, bandH: Double, windowH: Int): DoubleArray {
+        val a = minOf(lo, hi); val b = maxOf(lo, hi)
+        val all = listOf(top, bottom)
+            .map { y -> ColorMath.scaleAlpha(bar, bandCover(y, bandH, windowH)) }
+            .flatMap { ov -> listOf(under(a, ov), under(b, ov)) } + listOf(a, b)
+        return doubleArrayOf(all.min(), all.max())
+    }
+
+    /** Khoảng độ chói của một nền VẼ SẴN nhiều màu đục (không ảnh: nền chủ đề + hai vầng sáng của `WallView`). */
+    fun span(vararg colors: Int): DoubleArray {
+        require(colors.isNotEmpty())
+        val l = colors.map { ColorMath.luminance(it) }
+        return doubleArrayOf(l.min(), l.max())
+    }
+}
