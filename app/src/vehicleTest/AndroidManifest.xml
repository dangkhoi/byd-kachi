<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".HudSignProbeReceiver"
            android:exported="false" />

        <activity
            android:name=".HudSignProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="T10 vehicle-test status"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HAL PROBE (vehicleTest-only): bắn lệnh HAL nhanh qua adb để RE + kiểm tra trên xe.
             exported=true để `adb shell am broadcast -a com.byd.clusternav.vehicletest.HAL_PROBE …`
             tới được từ uid shell. Chỉ nằm ở src/vehicleTest → KHÔNG có trong release/debug APK. -->
        <receiver
            android:name=".HalProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.byd.clusternav.vehicletest.HAL_PROBE" />
            </intent-filter>
        </receiver>
        <!-- 3.01 R20 (vehicleTest-only): cắm SỐ GIẢ vào CarStatusTap để soát canh lề/co giãn widget trên máy ảo.
             exported=true để adb (uid shell) tới được. Không có trong release/debug. -->
        <receiver
            android:name=".DummyCarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.byd.clusternav.vehicletest.DUMMY_CAR" />
            </intent-filter>
        </receiver>
        <!-- 3.01 R23 (vehicleTest-only): gắn ảnh xe BYD trích firmware cho máy ảo (owner 13/10 cho phép CHỈ bản kiểm thử).
             Không xuất, không dữ liệu — chỉ để chạy onCreate lúc khởi động tiến trình. -->
        <provider
            android:name=".OemCarArtTestProvider"
            android:authorities="${applicationId}.vehicletest.oemcarart"
            android:exported="false" />
    </application>
</manifest>
