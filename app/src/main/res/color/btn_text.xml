<?xml version="1.0" encoding="utf-8"?>
<!-- Text follows the control's enabled state, so a disabled action is legible as disabled rather
     than looking identical to an available one. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/off_gray" />
    <item android:color="@color/text_primary" />
</selector>
