<?xml version="1.0" encoding="utf-8"?>
<!--
  group_bg — DESIGN SYSTEM (Cockpit L2) · @style/Cockpit.Group background. Matches the mockup `.group`
  (docs/specs/ui-visual-upgrade-l2.html): a vertical gradient surface_2(top)→surface(bottom), a
  1px @color/hairline stroke and 20dp corners. The soft drop shadow comes from android:elevation on the style.
  NOTE: Android <gradient> angle must be a multiple of 45 (270 = top→bottom, closest to the mockup 170deg).
  FIX (stage2-ui · T3): the former straight 1px top-highlight <item> did NOT follow the 20dp rounded
  corners, so it read as a DOUBLED line above the border at the corners. Removed — gradient + stroke +
  rounded corners + elevation keep the depth without the corner artifact.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base group face: vertical gradient + hairline stroke + rounded corners -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/surface_2"
                android:endColor="@color/surface" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
</layer-list>
