<?xml version="1.0" encoding="utf-8"?>
<!--
  pill_bg_green — DESIGN SYSTEM (Cockpit L2) · @style/Cockpit.Pill.Green background. Matches the mockup
  `.pill.gr` (docs/specs/ui-visual-upgrade-l2.html): a fully-rounded capsule filled with @color/accent_green
  at ~15% (ARGB 0x26 ≈ 15% of 255) over transparent; the label text is solid green (set in the style).
