<!--
  Hỗ trợ lái (ADAS) — cho 8 nút `adas_*`.
  [SOÁT P3] Tên "ic-adas" chưa được map nên 8 nút này lùi về icon nhóm AN TOÀN (hình lưới) — không gợi được nghĩa gì.
  Nét: xe nhìn từ trên + hai vệt quét phía trước (cảm biến/tầm nhìn), phân biệt rõ với "ic-radar" (chỉ có sóng quét).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- thân xe nhìn từ trên (nửa dưới khung) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M8.4,21 L8.4,14.6 C8.4,13.6 9,13 9.8,13 L14.2,13 C15,13 15.6,13.6 15.6,14.6 L15.6,21" />
    <!-- kính lái -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M9.8,15.4 L14.2,15.4" />
    <!-- hai vệt quét phía trước -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:pathData="M9.2,10.4 C10.1,8.9 13.9,8.9 14.8,10.4" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M7.6,7.2 C9.3,4.9 14.7,4.9 16.4,7.2" />
</vector>
