<?xml version="1.0" encoding="utf-8"?>
<!--
  segment_selected_bg — DESIGN SYSTEM (Cockpit L2) · SegmentedControlView SELECTED segment (default/cool).
  Matches the mockup `.seg span.on` (docs/specs/ui-visual-upgrade-l2.html): a blue→indigo gradient with
  8dp corners; selected label ink flips to white (set by the view). New drawable.
  NOTE: Android <gradient> angle must be a multiple of 45 (315 ≈ the mockup 150deg diagonal).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/accent_blue"
        android:endColor="@color/accent_indigo" />
    <corners android:radius="8dp" />
</shape>
