<?xml version="1.0" encoding="utf-8"?>
<!--
  segment_selected_warm_bg — DESIGN SYSTEM (Cockpit L2) · SegmentedControlView SELECTED segment when
  `warm=true` (e.g. the seat cool/heat toggle). Matches the mockup `.seg.warm span.on`
  (docs/specs/ui-visual-upgrade-l2.html): a warm pink→amber gradient with 8dp corners; selected label ink
  flips to white (set by the view). New drawable.
  NOTE: Android <gradient> angle must be a multiple of 45 (315 ≈ the mockup 150deg diagonal).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/accent_pink"
        android:endColor="@color/accent_amber" />
    <corners android:radius="8dp" />
</shape>
