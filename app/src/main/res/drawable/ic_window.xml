<!--
  KÍNH CỬA XE (một cửa kính, nhìn từ bên hông) — cho `window_*` và nhóm BODY.
  [KIỂM TOÁN UX mục 4a] Bản trước là một hình chữ nhật có gạch chữ THẬP giữa, tức đúng glyph ⊞ mà `ic_grid`
  ("Bảng tổng hợp") và icon lùi-về-nhóm của AN TOÀN (ESP) cũng đang dùng ⇒ MỘT hình mang BA nghĩa. Nay vẽ khung
  cửa hình thang có bệ dưới + đường kính hạ xuống, không thể lẫn với lưới.
  Chuẩn bộ icon: khung 24×24, hình trong ô 20×20, nét 1.6, đầu/khớp nét tròn, KHÔNG giữ màu riêng.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- khung cửa: hình thang (trụ trước nghiêng) -->
    <path android:pathData="M4.4,17.6 L4.4,9.6 L8.8,5.2 L19.6,5.2 L19.6,17.6 Z"
        android:fillColor="#00000000" android:strokeColor="#FFFFFF" android:strokeWidth="1.6"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
    <!-- bệ kính (đường hạ kính) -->
    <path android:pathData="M6.4,13.6 L17.6,13.6"
        android:fillColor="#00000000" android:strokeColor="#FFFFFF" android:strokeWidth="1.6"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>
