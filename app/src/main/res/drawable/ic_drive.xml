<!--
  Cần số / chế độ lái — cho nhóm `drive_*` (chế độ lái, mức phanh tái sinh, chế độ số).
  [SOÁT P3] Tên "ic-drive" chưa được map nên 3 nút này lùi về icon nhóm. Nét: cần số hình chữ H (sơ đồ số) tối giản.
  LỀ QUANG HỌC (T2): núm cần số trước có tâm y=3.4 bán kính 2.4 ⇒ đỉnh ở y=1.00, đâm ra mép khung. Nay tâm 4.4
  bán kính 2.0 ⇒ đỉnh 2.40, nằm trong ô 20×20. Đoạn nối núm–trục ngắn lại theo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- trục dọc + hai nhánh ngang = sơ đồ số H -->
    <path android:pathData="M12,7.6 L12,18.5 M7,10 L7,15.6 M17,10 L17,15.6 M7,12.8 L17,12.8"
        android:fillColor="#00000000" android:strokeColor="#FFFFFF" android:strokeWidth="1.6"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
    <!-- núm cần số: khối ĐẶC cố ý — đây là chi tiết vật lý của cần số, không phải icon nhận dạng riêng -->
    <path android:pathData="M12,4.4 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:fillColor="#FFFFFF" />
    <!-- nối núm với trục -->
    <path android:pathData="M12,6.4 L12,7.6"
        android:fillColor="#00000000" android:strokeColor="#FFFFFF" android:strokeWidth="1.6"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>
