<?xml version="1.0" encoding="utf-8"?>
<!--
  pill_bg — DESIGN SYSTEM (Cockpit) status-pill background. Fully-rounded @color/surface_2 fill + 1px
  @color/hairline_strong stroke. Neutral on purpose: the pill's TEXT colour carries the status
  (ok_green / warn_amber / err_red / text_secondary), the chip stays a calm dark capsule.
  Used by @style/Cockpit.StatusPill. New drawable (allowed).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_2" />
    <corners android:radius="999dp" />
    <stroke android:width="1dp" android:color="@color/hairline_strong" />
</shape>
