<?xml version="1.0" encoding="utf-8"?>
<!--
  spinner_bg — DESIGN SYSTEM (Cockpit) Spinner face. Rounded ~10dp @color/surface_2 fill + 1px
  @color/hairline_strong stroke, with a right-aligned chevron (@drawable/ic_chevron_down) inset from
  the end edge. Wired app-wide via AppTheme android:spinnerStyle -> @style/Cockpit.Spinner, so all
  framework Spinners adopt the cockpit face WITHOUT editing the sealed layouts.
  The Spinner style adds paddingEnd so the selected text never overlaps the chevron.
  New drawable (allowed).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Face: rounded fill + hairline stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/hairline_strong" />
        </shape>
    </item>
    <!-- Dropdown chevron, pinned to the end edge, vertically centred (14dp inset from the end). -->
    <item
        android:width="18dp"
        android:height="18dp"
        android:gravity="center_vertical|end"
        android:end="14dp"
        android:drawable="@drawable/ic_chevron_down" />
</layer-list>
