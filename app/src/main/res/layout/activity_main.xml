<?xml version="1.0" encoding="utf-8"?><!--
  Home — MÀN HÌNH DUY NHẤT, tái dựng theo LEVEL-2 "COCKPIT" (docs/specs/ui-visual-upgrade-l2.html): nền tối,
  HERO trạng-thái-sống trên cùng, rồi BẢNG tính năng gồm các @style/Cockpit.Group (viền + bóng + bo góc) mà
  bên trong xếp @style/Cockpit.Row ngăn nhau bằng @style/Cockpit.RowDivider. Mọi bề mặt compose từ hệ thiết
  kế Cockpit.* (res/values/styles.xml) + các custom view (SegmentedControlView / SpeedDialView /
  ClusterPreviewView / SeatDiagramView / Pm25GaugeView). CHỈ ĐỔI TRÌNH BÀY — feature/pipeline/grant/runtime
  không đổi.

  ── Cơ chế GẬP (tag-based, KHÔNG thêm @+id) ─────────────────────────────────────────────────────────
  Mỗi thẻ gập = hàng tiêu đề (tag toggle-prefix, clickable) + thân (tag body-prefix); dòng tóm tắt (tag
  sum-prefix). MainActivity.setupCollapsibleCards() nối bằng findViewWithTag. 5 thẻ gập:
  nav · vk · badge · bubble · seat (⇒ 15 tag; CollapseTagParityContractTest khoá parity). Cluster Cast KHÔNG
  gập bằng tag — thân cast_body do công tắc chính điều khiển (CastEnableSwitch).

  ── Bộ @+id ĐỒNG BỘ với layout-w960dp (LayoutVariantIdParityTest) ───────────────────────────────────
  Đổi có chủ ý so với "lần 17": GỠ spinner_cluster_mode → seg_cluster_mode (SegmentedControlView); GỠ
  seat_comfort_mode/seat_mode_cool/seat_mode_heat → seg_seat_mode (SegmentedControlView, warm); hero_speed
  đổi TextView → SpeedDialView (id giữ); THÊM hero_cast_preview (ClusterPreviewView). Các @+id khác GIỮ,
  dời vào cấu trúc mới. cb_hud + txt_hud_status giữ (visibility=gone); 4 id HUD-BLE giữ dạng comment cho
  parity/count. File này bị byte-seal T11 — đổi có chủ ý phải cập nhật hằng trong ExpansionTransportFenceTest
  (lần 18).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/screen_pad"
        android:clipChildren="false" android:clipToPadding="false">

        <!-- ── Page header ─────────────────────────────────────────────────────────────────────── -->
        <TextView android:id="@+id/txt_app_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap"
            android:text="ClusterNav" style="@style/Cockpit.Text.Title" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="9dp" android:text="Trạng thái sống"
            style="@style/Cockpit.Text.SectionHeader" />

        <!-- ══ HERO · trạng thái sống (glanceable, READ-ONLY — nối trong MainActivity.updateHeroStrip) ══
             Bản dọc: 3 thẻ Cockpit.HeroCard XẾP CHỒNG (bản rộng xếp 3 cột 1.4/1/1). -->

        <!-- HERO 1 · NAV -->
        <LinearLayout style="@style/Cockpit.HeroCard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="9dp"
                    android:scaleType="fitCenter" android:src="@drawable/ic_nav_g" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Đang dẫn · Google Maps" style="@style/Cockpit.HeroLead" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="11dp">
                <ImageView android:id="@+id/hero_nav_icon" android:layout_width="56dp" android:layout_height="56dp"
                    android:layout_marginEnd="16dp" android:padding="13dp" android:scaleType="fitCenter"
                    android:background="@drawable/turn_tile_bg" android:src="@drawable/ic_turn_right_g"
                    android:contentDescription="Hướng rẽ" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/hero_dist" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" style="@style/Cockpit.HeroDist" />
                    <TextView android:id="@+id/hero_road" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Đang chờ nguồn" android:maxLines="1"
                        android:ellipsize="end" style="@style/Cockpit.HeroStreet" />
                </LinearLayout>
                <com.byd.clusternav.ui.SpeedDialView android:id="@+id/hero_speed"
                    android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="12dp"
                    android:contentDescription="Tốc độ" />
            </LinearLayout>
            <!-- hero_vk (phím-thoại) — GIỮ id + nối trong updateHeroStrip, nhưng ẩn: HERO L2 không có thẻ
                 phím-thoại (trạng thái phím-thoại đã hiện đầy đủ ở thẻ "Nút vật lý → Trợ lý"). -->
            <TextView android:id="@+id/hero_vk" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:text="Phím-thoại: —" style="@style/Cockpit.HeroStreet" />
        </LinearLayout>

        <!-- HERO 2 · CAST -->
        <LinearLayout style="@style/Cockpit.HeroCard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="9dp"
                    android:scaleType="fitCenter" android:src="@drawable/ic_cast_g" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Cluster Cast" style="@style/Cockpit.HeroLead" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="11dp">
                <View android:id="@+id/dot_cast" android:layout_width="9dp" android:layout_height="9dp"
                    android:layout_marginEnd="10dp" android:background="@drawable/status_dot" />
                <TextView android:id="@+id/hero_cast" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Chiếu cụm: —" android:maxLines="1" android:ellipsize="end"
                    style="@style/Cockpit.Text.Value" />
            </LinearLayout>
            <com.byd.clusternav.ui.ClusterPreviewView android:id="@+id/hero_cast_preview"
                android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="11dp"
                android:contentDescription="Xem trước cụm" />
        </LinearLayout>

        <!-- HERO 3 · QUICK -->
        <LinearLayout style="@style/Cockpit.HeroCard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="9dp"
                    android:scaleType="fitCenter" android:src="@drawable/ic_clock_g" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Nhanh" style="@style/Cockpit.HeroLead" />
            </LinearLayout>
            <Button android:id="@+id/cast_zone_full" style="@style/Cockpit.Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp"
                android:background="@drawable/btn_primary" android:textColor="@android:color/white"
                android:drawableStart="@drawable/ic_cast_g" android:drawablePadding="8dp"
                android:text="Chiếu full cụm" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="7dp">
                <Button android:id="@+id/cast_zone_left" style="@style/Cockpit.Button.Secondary"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp" android:drawableStart="@drawable/ic_left_g"
                    android:drawablePadding="8dp" android:text="Trái" />
                <Button android:id="@+id/cast_zone_right" style="@style/Cockpit.Button.Secondary"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:drawableStart="@drawable/ic_right_g"
                    android:drawablePadding="8dp" android:text="Phải" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════ BẢNG TÍNH NĂNG (1 cột) ══════════════════════════════ -->

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:layout_marginBottom="9dp" android:text="Bảng tính năng"
            style="@style/Cockpit.Text.SectionHeader" />

        <!-- ── GROUP · Navigation + HUD (gập, mở sẵn) ─────────────────────────────────────────── -->
        <LinearLayout style="@style/Cockpit.Group"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout style="@style/Cockpit.Row" android:tag="toggle_nav"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/ic_nav" style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_nav" android:src="@drawable/ic_nav_g"
                    android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Navigation + HUD" style="@style/Cockpit.Row.Title" />
                    <TextView android:tag="sum_nav" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Dẫn đường trên cụm + HUD" style="@style/Cockpit.Row.Subtitle" />
                </LinearLayout>
                <Switch android:id="@+id/switch_enabled" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp" />
            </LinearLayout>
            <View style="@style/Cockpit.RowDivider" />
            <!-- status mini-area (luôn hiện) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="9dp" android:paddingBottom="9dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/dot_status" android:layout_width="12dp" android:layout_height="12dp"
                        android:layout_marginEnd="10dp" android:background="@drawable/status_dot" />
                    <TextView android:id="@+id/txt_status" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Đang chờ nguồn" style="@style/Cockpit.Text.Hint" />
                </LinearLayout>
                <TextView android:id="@+id/txt_lane_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:text="Cụm: tắt" style="@style/Cockpit.Text.Hint" />
                <TextView android:id="@+id/txt_hud_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="HUD: tắt" android:visibility="gone"
                    style="@style/Cockpit.Text.Hint" />
                <TextView android:id="@+id/txt_nav_source_active" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Đang dẫn: —"
                    style="@style/Cockpit.Text.Hint" android:contentDescription="Nguồn dẫn đường đang hoạt động" />
                <TextView android:id="@+id/txt_cluster_op39_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="Cụm: chờ dẫn đường" style="@style/Cockpit.Text.Hint"
                    android:contentDescription="Trạng thái hiển thị dẫn đường trên cụm" />
            </LinearLayout>
            <!-- body_nav (gập) -->
            <LinearLayout android:tag="body_nav" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingBottom="13dp">
                <!-- #6: nav→HUD output toggle ẩn; id giữ (visibility=gone) để findViewById không null. -->
                <CheckBox android:id="@+id/cb_hud" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min" android:text="Bật đầu ra HUD độc lập"
                    android:textColor="@color/text_secondary" android:visibility="gone" />
                <LinearLayout style="@style/Cockpit.Row" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="0dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Chế độ cụm" style="@style/Cockpit.Row.Title" />
                    <com.byd.clusternav.ui.SegmentedControlView android:id="@+id/seg_cluster_mode"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Chế độ hiển thị trên cụm (Bật: Giữa + ETA / Tắt)" />
                </LinearLayout>
                <LinearLayout style="@style/Cockpit.Row" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="0dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Chạy chữ tên đường dài" style="@style/Cockpit.Row.Title" />
                    <Switch android:id="@+id/cb_marquee" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <Button android:id="@+id/btn_reconnect_nav" style="@style/Cockpit.Button.Compact.Secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="start" android:layout_marginTop="7dp"
                    android:text="Cấp quyền / kết nối lại" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── GROUP · Cluster Cast (thân theo công tắc chính, không dùng tag gập) ────────────── -->
        <LinearLayout style="@style/Cockpit.Group"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap">
            <LinearLayout style="@style/Cockpit.Row"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:id="@+id/ic_cast" style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_cast" android:src="@drawable/ic_cast_g"
                    android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Cluster Cast" style="@style/Cockpit.Row.Title" />
                    <TextView android:id="@+id/txt_cast_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Sẵn sàng" style="@style/Cockpit.Row.Subtitle" />
                </LinearLayout>
                <Switch android:id="@+id/switch_cast_enabled" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:contentDescription="Bật hoặc tắt Cluster Cast" />
            </LinearLayout>
            <TextView android:id="@+id/txt_cast_disabled_hint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingBottom="7dp" android:visibility="gone"
                android:text="Đang tắt · cụm vẫn hiện dẫn đường và HUD như thường. Bật để chiếu app lên cụm."
                style="@style/Cockpit.Text.Hint" />
            <!-- Thân Cast — hiện khi công tắc BẬT (CastEnableSwitch). -->
            <LinearLayout android:id="@+id/cast_body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="13dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Chạm nút nổi để chiếu app đang mở · chạm lại để về màn chính"
                    style="@style/Cockpit.Text.Hint" />
                <FrameLayout android:id="@+id/cast_geometry_container" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="9dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="11dp" android:layout_marginBottom="11dp" android:background="@color/divider" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Tỉ lệ chia đôi cụm — dùng khi chạm ô nửa trái/nửa phải của nút nổi"
                    style="@style/Cockpit.Text.Hint" />
                <LinearLayout android:id="@+id/split_ratio_buttons" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp"
                    android:contentDescription="Tỉ lệ chia đôi cụm khi chiếu hai app" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="11dp" android:layout_marginBottom="11dp" android:background="@color/divider" />
                <Switch android:id="@+id/cb_autostart" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min" android:textColor="@color/text_secondary"
                    android:text="Tự khởi động: chiếu full cụm" />
                <Spinner android:id="@+id/spinner_autostart_app" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp" android:minHeight="@dimen/touch_min" />
                <Switch android:id="@+id/cb_autostart_split" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min" android:textColor="@color/text_secondary"
                    android:text="Tự khởi động: chia đôi (trái + phải)" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="5dp">
                    <Spinner android:id="@+id/spinner_autostart_left" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp" android:minHeight="@dimen/touch_min"
                        android:contentDescription="App tự chiếu bên trái" />
                    <Spinner android:id="@+id/spinner_autostart_right" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:minHeight="@dimen/touch_min"
                        android:contentDescription="App tự chiếu bên phải" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── GROUP · Nút vật lý → Trợ lý (gập, mở sẵn) ──────────────────────────────────────── -->
        <LinearLayout style="@style/Cockpit.Group"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap">
            <LinearLayout style="@style/Cockpit.Row" android:tag="toggle_vk"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/ic_mic" style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_mic" android:src="@drawable/ic_mic_g"
                    android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Nút vật lý → Trợ lý" style="@style/Cockpit.Row.Title" />
                    <TextView android:tag="sum_vk" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Nút vật lý → mở app / trợ lý" style="@style/Cockpit.Row.Subtitle" />
                </LinearLayout>
                <Switch android:id="@+id/switch_voicekey_enabled" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:contentDescription="Bật hoặc tắt kích hoạt trợ lý bằng nút vật lý" />
            </LinearLayout>
            <!-- status + recheck (luôn hiện; PHẢI giữ thứ tự switch < status < recheck — VoiceKeyStatusWiringContractTest) -->
            <TextView android:id="@+id/txt_voicekey_status" style="@style/Cockpit.StatusPill"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginTop="4dp" android:text="Phím-thoại: —" />
            <Button android:id="@+id/btn_voicekey_recheck" style="@style/Cockpit.Button.Compact.Secondary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="7dp"
                android:text="Kiểm tra / Sửa ngay" android:contentDescription="Kiểm tra và sửa kết nối phím thoại" />
            <!-- body_vk (gập) -->
            <LinearLayout android:tag="body_vk" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="7dp" android:paddingBottom="13dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Gán nút (vô-lăng/táp-lô) để mở app. Gán được NHIỀU nút cho NHIỀU app. Không đổi chức năng gốc của nút chưa gán."
                    style="@style/Cockpit.Text.Hint" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="11dp" android:text="1 · Chọn nút" style="@style/Cockpit.Text.Hint" />
                <Spinner android:id="@+id/spinner_voicekey_button" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" />
                <TextView android:id="@+id/txt_voicekey_current" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Nút đang chọn: —" style="@style/Cockpit.Text.Hint" />
                <Button android:id="@+id/btn_voicekey_learn" style="@style/Cockpit.Button.Compact.Secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="start" android:layout_marginTop="7dp"
                    android:text="Học phím mới…" android:contentDescription="Học một nút vật lý mới trên xe" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="11dp" android:text="2 · Chọn app sẽ mở" style="@style/Cockpit.Text.Hint" />
                <Spinner android:id="@+id/spinner_voicekey_target" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" />
                <Button android:id="@+id/btn_voicekey_add" style="@style/Cockpit.Button.Compact.Secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="start" android:layout_marginTop="9dp"
                    android:text="3 · Thêm gán" android:contentDescription="Thêm cặp nút và app đang chọn vào danh sách gán" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="13dp" android:text="Đã gán (app chỉ nghe theo danh sách này)"
                    style="@style/Cockpit.Text.Hint" />
                <TextView android:id="@+id/txt_voicekey_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Chưa gán nút nào — hiện KHÔNG có nút nào mở app. Chọn nút + app rồi bấm “Thêm gán”."
                    style="@style/Cockpit.Text.Hint" />
                <LinearLayout android:id="@+id/list_voicekey_bindings" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── GROUP · Trên cụm: Biển báo tốc độ + Bóng VietMap (2 thẻ gập) ───────────────────── -->
        <LinearLayout style="@style/Cockpit.Group"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap">
            <!-- Biển báo tốc độ (gập, đóng sẵn) -->
            <LinearLayout style="@style/Cockpit.Row" android:tag="toggle_badge"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/ic_badge" style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_badge" android:src="@drawable/ic_badge_g"
                    android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Biển báo tốc độ" style="@style/Cockpit.Row.Title" />
                    <TextView android:tag="sum_badge" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Biển báo tốc độ + cảnh báo trên cụm" style="@style/Cockpit.Row.Subtitle" />
                </LinearLayout>
                <Switch android:id="@+id/switch_badge_enabled" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp" android:checked="true"
                    android:contentDescription="Bật hoặc tắt biển báo tốc độ trên cụm" />
            </LinearLayout>
            <LinearLayout android:tag="body_badge" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingBottom="13dp">
                <Switch android:id="@+id/switch_upcoming_badge" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:checked="true"
                    android:text="Hiện giới hạn sắp tới" android:textColor="@color/text_secondary"
                    android:contentDescription="Bật hoặc tắt biển giới hạn tốc độ sắp tới trên cụm" />
                <Switch android:id="@+id/switch_alert_chip" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="@dimen/touch_min"
                    android:checked="false" android:text="Hiện cảnh báo/camera VietMap" android:textColor="@color/text_secondary"
                    android:contentDescription="Bật hoặc tắt chip cảnh báo/camera VietMap trên cụm" />
                <TextView android:id="@+id/txt_speed_source_bind" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Nguồn: chưa kết nối"
                    style="@style/Cockpit.Text.Hint" />
                <Button android:id="@+id/btn_vietmap_widget_diag" style="@style/Cockpit.Button.Secondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:text="Kết nối / Dữ liệu VietMap" />
                <FrameLayout android:id="@+id/badge_placement_container" android:layout_width="match_parent"
                    android:layout_height="98dp" android:layout_marginTop="9dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="Cỡ" style="@style/Cockpit.Text.Hint" />
                    <SeekBar android:id="@+id/seek_badge_size" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
                        android:contentDescription="Cỡ biển báo tốc độ" />
                </LinearLayout>
            </LinearLayout>
            <View style="@style/Cockpit.RowDivider" />
            <!-- Bóng VietMap (gập, đóng sẵn) -->
            <LinearLayout style="@style/Cockpit.Row" android:tag="toggle_bubble"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/ic_bubble" style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_bubble" android:src="@drawable/ic_bubble_g"
                    android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Bóng VietMap" style="@style/Cockpit.Row.Title" />
                    <TextView android:tag="sum_bubble" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Vị trí bóng VietMap trên cụm (cần Cast)" style="@style/Cockpit.Row.Subtitle" />
                </LinearLayout>
                <Switch android:id="@+id/switch_vm_bubble_enabled" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp" android:checked="false"
                    android:contentDescription="Bật hoặc tắt bong bóng VietMap trên cụm" />
            </LinearLayout>
            <LinearLayout android:tag="body_bubble" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingBottom="13dp">
                <TextView android:id="@+id/txt_vm_pos_hint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Bật Cluster Cast để chỉnh vị trí"
                    style="@style/Cockpit.Text.Hint" />
                <FrameLayout android:id="@+id/vm_bubble_placement_container" android:layout_width="match_parent"
                    android:layout_height="98dp" android:layout_marginTop="9dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── GROUP · Ghế: làm mát / sưởi (gập, đóng sẵn) ────────────────────────────────────── -->
        <LinearLayout style="@style/Cockpit.Group"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap">
            <LinearLayout style="@style/Cockpit.Row" android:tag="toggle_seat"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/ic_seat" style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_seat" android:src="@drawable/ic_seat_g"
                    android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/txt_seat_comfort_title" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="Ghế: làm mát / sưởi" style="@style/Cockpit.Row.Title" />
                    <TextView android:tag="sum_seat" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Làm mát / sưởi ghế tự động" style="@style/Cockpit.Row.Subtitle" />
                </LinearLayout>
                <com.byd.clusternav.ui.SegmentedControlView android:id="@+id/seg_seat_mode"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:contentDescription="Chế độ ghế: làm mát / sưởi" />
                <Switch android:id="@+id/switch_seat_comfort_enabled" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:contentDescription="Bật hoặc tắt làm mát / sưởi ghế tự động" />
            </LinearLayout>
            <LinearLayout android:tag="body_seat" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingBottom="13dp">
                <TextView android:id="@+id/txt_seat_comfort_hint" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tự áp dụng ~5 giây sau khi mở app / nổ máy. Làm mát và sưởi loại trừ nhau."
                    style="@style/Cockpit.Text.Hint" />
                <com.byd.clusternav.comfort.SeatDiagramView android:id="@+id/seat_diagram"
                    android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="9dp"
                    android:contentDescription="Sơ đồ ghế nhìn từ trên — chạm ghế để chọn mức 0/1/2" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── GROUP · Tự lọc bụi mịn PM2.5 (không gập) ───────────────────────────────────────── -->
        <LinearLayout style="@style/Cockpit.Group"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap">
            <LinearLayout style="@style/Cockpit.Row"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:id="@+id/ic_dust" style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_dust" android:src="@drawable/ic_dust_g"
                    android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/txt_pm25_title" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="Tự lọc bụi mịn" style="@style/Cockpit.Row.Title" />
                    <TextView android:id="@+id/txt_pm25_level" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—" style="@style/Cockpit.Row.Subtitle" />
                </LinearLayout>
                <com.byd.clusternav.comfort.Pm25GaugeView android:id="@+id/pm25_gauge"
                    android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" android:contentDescription="Đồng hồ mức bụi mịn PM2.5" />
                <Switch android:id="@+id/switch_pm25_filter" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Bật hoặc tắt tự lọc bụi mịn PM2.5" />
            </LinearLayout>
            <Button android:id="@+id/btn_pm25_clean_now" style="@style/Cockpit.Button.Compact.Secondary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="7dp"
                android:text="Lọc ngay" android:contentDescription="Lọc bụi mịn ngay bây giờ" />
        </LinearLayout>

        <!-- ── GROUP · Hệ thống + Nâng cao ────────────────────────────────────────────────────── -->
        <LinearLayout style="@style/Cockpit.Group"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap">
            <LinearLayout style="@style/Cockpit.Row"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:id="@+id/ic_sys" style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_sys" android:src="@drawable/ic_sys_g"
                    android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Tự khởi động nền" style="@style/Cockpit.Row.Title" />
                <Switch android:id="@+id/cb_headless_autostart" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp" />
            </LinearLayout>
            <View style="@style/Cockpit.RowDivider" />
            <!-- Ngôn ngữ / Language — 3-cách (Theo xe / VI / EN); nối trong MainActivity.setupLanguageSelector. -->
            <LinearLayout style="@style/Cockpit.Row"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_sys" android:src="@drawable/ic_lang_g"
                    android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Ngôn ngữ / Language" style="@style/Cockpit.Row.Title" />
                <com.byd.clusternav.ui.SegmentedControlView android:id="@+id/seg_language"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:contentDescription="Ngôn ngữ / Language" />
            </LinearLayout>
            <View style="@style/Cockpit.RowDivider" />
            <!-- Giao diện / Theme — 3-cách (Theo xe / Sáng / Tối); nối trong MainActivity.setupThemeSelector. -->
            <LinearLayout style="@style/Cockpit.Row"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_sys" android:src="@drawable/ic_adv_g"
                    android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Giao diện" style="@style/Cockpit.Row.Title" />
                <com.byd.clusternav.ui.SegmentedControlView android:id="@+id/seg_theme"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:contentDescription="Giao diện" />
            </LinearLayout>
            <View style="@style/Cockpit.RowDivider" />
            <LinearLayout style="@style/Cockpit.Row"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:id="@+id/ic_adv" style="@style/Cockpit.Row.Tile"
                    android:background="@drawable/tile_adv" android:src="@drawable/ic_adv_g"
                    android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Nâng cao · cập nhật" style="@style/Cockpit.Row.Title" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingBottom="13dp">
                <Button android:id="@+id/btn_check_update" style="@style/Cockpit.Button.Compact.Secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="start" android:layout_marginTop="7dp"
                    android:text="⬇ Kiểm tra cập nhật" />
                <TextView android:id="@+id/cast_recovery_toggle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center_vertical"
                    android:layout_marginTop="7dp" android:text="Khắc phục sự cố"
                    android:textSize="@dimen/text_body" android:textColor="@color/brand" android:focusable="true"
                    android:contentDescription="Mở hoặc đóng nhóm hành động khắc phục sự cố" />
                <LinearLayout android:id="@+id/cast_recovery_actions" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <Button android:id="@+id/btn_nav_stop" style="@style/Cockpit.Button.Compact.Warning"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="Dừng toàn bộ" />
                    <Button android:id="@+id/cast_stop" style="@style/Cockpit.Button.Compact.Warning"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="start" android:layout_marginTop="5dp"
                        android:text="Dừng — trả đồng hồ"
                        android:contentDescription="Dừng Cluster Cast và trả đồng hồ" />
                    <Button android:id="@+id/cast_diagnostics" style="@style/Cockpit.Button.Compact.Text"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="start" android:layout_marginTop="5dp"
                        android:text="Chẩn đoán"
                        android:contentDescription="Mở chẩn đoán Cluster Cast chỉ đọc" />
                    <Button android:id="@+id/cast_clear_cluster" style="@style/Cockpit.Button.Compact.Warning"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="start" android:layout_marginTop="5dp"
                        android:text="Trả cụm về đồng hồ (cứu hộ)"
                        android:contentDescription="Trả cụm về đồng hồ: đưa mọi app trên cụm về màn chính rồi đóng đường chiếu" />
                    <Button android:id="@+id/cast_deep_rescue" style="@style/Cockpit.Button.Compact.Warning"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="start" android:layout_marginTop="5dp"
                        android:text="Dọn sạch cụm (gỡ kẹt DashCast)"
                        android:contentDescription="Dọn sạch cụm khi kẹt do DashCast: dừng hẳn chiếu của app này, force-stop DashCast, reset cụm về đồng hồ. Không mở lại chiếu." />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- VietMap HUD BLE Bridge — HIDDEN (hardware not supported, research pending). Ids kept as commented
             text for @+id parity/count (dot_hud_ble / txt_hud_ble_status / txt_hud_ble_data / btn_hud_ble_toggle). -->
        <!--
        <LinearLayout style="@style/Cockpit.Group" android:layout_width="match_parent" android:layout_height="wrap_content">
            <View android:id="@+id/dot_hud_ble" android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/status_dot" />
            <TextView android:id="@+id/txt_hud_ble_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tắt" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/txt_hud_ble_data" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/text_secondary" android:fontFamily="monospace" />
            <Button android:id="@+id/btn_hud_ble_toggle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/btn_outline"
                android:text="Bật HUD BLE" android:textAllCaps="false" android:textColor="@color/brand" />
        </LinearLayout>
        -->

    </LinearLayout>
</ScrollView>
